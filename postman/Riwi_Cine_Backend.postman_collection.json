  "item": [
    {
      "name": "01 - Autenticación y Seguridad",
      "description": "Endpoints para inicio de sesión, generación de token JWT con expiración configurable y verificación de códigos de 6 dígitos (2FA).",
      "item": [
        {
          "name": "POST /api/auth/login - Iniciar Sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.environment.set(\"accessToken\", res.token);",
                  "        pm.collectionVariables.set(\"accessToken\", res.token);",
                  "        console.log(\"Token JWT guardado automáticamente en accessToken:\", res.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "### Descripción\nValida las credenciales (correo y contraseña). Compara la contraseña con el hash Bcrypt en BD y emite un JWT firmado válido por 30m.\n\n**Nota**: Al ejecutarse con éxito, guarda automáticamente el `token` en la variable `{{accessToken}}`."
          },
          "response": [
            {
              "name": "200 OK - Login Exitoso",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"\\u00a1Login exitoso!\",\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"datos\": {\n    \"id\": 1,\n    \"name\": \"Ana Garc\\u00eda\",\n    \"email\": \"ana@example.com\"\n  }\n}"
            },
            {
              "name": "401 Unauthorized - Credenciales Inválidas",
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"message\": \"Credenciales inv\\u00e1lidas (contrase\\u00f1a incorrecta)\"\n}"
            }
          ]
        },
        {
